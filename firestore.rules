// Unified Firestore Security Rules for jump-15472
// Shared Single Source of Truth across:
//   1. BestClubVN (C:\Users\Asus\Desktop\project\jumper\jumper_v10)
//   2. BestERP (C:\Users\Asus\Desktop\project\BEST\BEST_ERP)
//   3. 대한김치 (C:\Users\Asus\Desktop\project\대한김치-2\web)
//   4. BEST WINNER (C:\Users\Asus\Desktop\project\BESTwinnner_web)
// ⚠️ 주의: 이 파일은 BestClubVN과 BestERP 양쪽 저장소에 항상 100% 동일하게 유지되어야 합니다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // 문서가 없으면 아무 권한도 없는 GUEST 로 본다. (예전 기본값 EMPLOYEE 는 직원 권한을 통과시켰음)
    function getUserData() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : {"role": "GUEST"};
    }

    // 이메일로 권한을 주는 경우는 인증된(email_verified) 이메일만 인정한다.
    function hasVerifiedEmailIn(emails) {
      return signedIn()
        && (request.auth.token.email is string)
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in emails;
    }

    function isOperatorEmail() {
      return hasVerifiedEmailIn(['daguri75@gmail.com']);
    }

    // 본인이 스스로 넣을 수 없는 role 값 (관리자/승인으로만 부여)
    function isPrivilegedRole(r) {
      return (r is string) && r.upper() in [
        'SUPER_ADMIN', 'CEO', 'ADMIN', 'STAFF', 'EMPLOYEE', 'FRANCHISE', 'MERCHANT'
      ];
    }

    // 본인이 스스로 바꿀 수 없는 users 필드
    function protectedUserFields() {
      return ['isAdmin', 'merchantId', 'merchant_id', 'teamId', 'tenant_id', 'tenantId', 'company_id', 'employeeDocId'];
    }

    function isSuperAdmin() {
      return signedIn() && (
        isOperatorEmail() ||
        getUserData().get('role', '') == 'SUPER_ADMIN'
      );
    }

    // 가맹점 대표: role 로만 판정한다. (merchantId 보유나 가맹점 신청 여부만으로는 CEO 가 아님)
    function isCEO() {
      return signedIn() && (
        hasVerifiedEmailIn(['daguri75@gmail.com', 'hexttokenopbnb@gmail.com']) ||
        getUserData().get('role', '') in ['SUPER_ADMIN', 'CEO', 'ceo', 'FRANCHISE', 'franchise', 'MERCHANT', 'merchant']
      );
    }

    // ERP 사용 권한(직원 이상). 가맹점에 소속(merchantId)된 사용자도 포함.
    // merchantId 는 본인이 바꿀 수 없고 관리자/점주 승인으로만 들어간다.
    function isStaff() {
      return signedIn() && (
        hasVerifiedEmailIn(['daguri75@gmail.com', 'hexttokenopbnb@gmail.com']) ||
        getUserData().get('role', '') in ['SUPER_ADMIN', 'CEO', 'ceo', 'ADMIN', 'admin', 'STAFF', 'staff', 'EMPLOYEE', 'FRANCHISE', 'franchise', 'MERCHANT', 'merchant'] ||
        getUserData().get('merchantId', null) != null
      );
    }

    // 플랫폼(본사) 관리자. 가맹점 대표(CEO)는 여기에 포함되지 않는다.
    function isAdmin() {
      return signedIn()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || isOperatorEmail()
          || isSuperAdmin()
          || getUserData().get('isAdmin', false) == true
          || getUserData().get('role', '') in ['SUPER_ADMIN', 'ADMIN', 'admin']
        );
    }

    // 사용자 데이터 u 의 소속 가맹점이 tenantId 인지
    function tenantMatch(u, tenantId) {
      return tenantId != null && tenantId != '' && (
        u.get('tenant_id', null) == tenantId ||
        u.get('tenantId', null) == tenantId ||
        u.get('merchantId', null) == tenantId ||
        u.get('merchant_id', null) == tenantId ||
        request.auth.uid == tenantId
      );
    }

    // 로그인 사용자의 소속 가맹점이 tenantId 인지
    function isMyTenant(tenantId) {
      return signedIn() && tenantMatch(getUserData(), tenantId);
    }

    // 해당 가맹점 데이터 접근: 본사 관리자 또는 그 가맹점 소속만
    function belongsToTenant(tenantId) {
      return signedIn() && (isSuperAdmin() || isAdmin() || isMyTenant(tenantId));
    }

    // 문서 d 의 가맹점 필드가 모두 비어 있거나 u(로그인 사용자)의 가맹점인지
    function tenantFieldsMineOrEmpty(u, d) {
      return (d.get('merchantId', null) == null || tenantMatch(u, d.get('merchantId', null)))
        && (d.get('merchant_id', null) == null || tenantMatch(u, d.get('merchant_id', null)))
        && (d.get('tenantId', null) == null || tenantMatch(u, d.get('tenantId', null)))
        && (d.get('tenant_id', null) == null || tenantMatch(u, d.get('tenant_id', null)));
    }

    // 본인 users 문서 수정: 권한 role 과 소속 필드는 못 바꾼다.
    function selfUserWriteOk(uid) {
      return signedIn() && request.auth.uid == uid
        && (
          resource == null
            ? (!request.resource.data.keys().hasAny(protectedUserFields())
               && !isPrivilegedRole(request.resource.data.get('role', '')))
            : (!request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
               && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                   || !isPrivilegedRole(request.resource.data.get('role', ''))))
        );
    }

    // 직원 연결(점주 승인 / 직원 본인 연결) 때 바뀔 수 있는 users 필드
    function staffLinkFields() {
      return ['email', 'name', 'role', 'status', 'position', 'department',
              'merchantId', 'merchant_id', 'tenantId', 'tenant_id', 'storeName',
              'employeeDocId', 'updatedAt'];
    }

    function onlyStaffLinkFieldsChanged() {
      return resource == null
        ? request.resource.data.keys().hasOnly(staffLinkFields())
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffLinkFields());
    }

    // 점주가 등록한 직원(employees)이 처음 로그인할 때 스스로 STAFF 로 연결.
    // employees 문서의 contact 이메일이 로그인한 인증 이메일과 같고, 소속은 그 직원 문서의 가맹점으로만.
    function selfStaffClaimOk(uid) {
      let d = request.resource.data;
      let empId = d.get('employeeDocId', '');
      let empPath = /databases/$(database)/documents/employees/$(empId);
      let emp = get(empPath).data;
      let t = emp.get('tenantId', null);
      return signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && (request.auth.token.email is string)
        && (empId is string) && empId != ''
        && exists(empPath)
        && (emp.get('contact', '') is string)
        && emp.get('contact', '').lower() == request.auth.token.email.lower()
        && t != null
        && d.get('role', '') == 'STAFF'
        && d.get('isAdmin', false) == false
        && d.get('merchantId', null) == t
        && d.get('tenantId', null) == t
        && d.get('tenant_id', t) == t
        && d.get('merchant_id', t) == t
        && onlyStaffLinkFieldsChanged()
        && (resource == null || !isPrivilegedRole(resource.data.get('role', '')) || resource.data.get('role', '') == 'STAFF');
    }

    // 점주(CEO)가 다른 사용자를 자기 가맹점 직원으로 연결/해제.
    // 다른 점주·관리자 계정은 건드릴 수 없고, 소속은 자기 가맹점으로만 넣을 수 있다.
    function ceoManagesUserOk(uid) {
      let u = getUserData();
      let d = request.resource.data;
      return signedIn() && request.auth.uid != uid
        && (hasVerifiedEmailIn(['daguri75@gmail.com', 'hexttokenopbnb@gmail.com'])
            || u.get('role', '') in ['SUPER_ADMIN', 'CEO', 'ceo', 'FRANCHISE', 'franchise', 'MERCHANT', 'merchant'])
        && d.get('role', 'VIEWER') in ['STAFF', 'EMPLOYEE', 'VIEWER', 'GUEST']
        && onlyStaffLinkFieldsChanged()
        && tenantFieldsMineOrEmpty(u, d)
        && (resource == null || (
              (!isPrivilegedRole(resource.data.get('role', ''))
                || resource.data.get('role', '') in ['STAFF', 'EMPLOYEE'])
              && tenantFieldsMineOrEmpty(u, resource.data)
              && resource.data.get('isAdmin', false) == false
           ));
    }

    function isOrderBuyer() {
      return signedIn()
        && (resource.data.buyerUid is string)
        && resource.data.buyerUid == request.auth.uid;
    }

    function isOrderGuide() {
      return signedIn()
        && (resource.data.guideUid is string)
        && resource.data.guideUid == request.auth.uid;
    }

    function buyerPayProofUpdateOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["proof","paymentStatus","payProofUpdatedAt"]);
    }

    // 최고관리자는 모든 컬렉션에서 읽기/쓰기 권한 보유
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── BestClubVN Core Collections ───────────────────────────────────────────

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /guideApplications/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /guides/{uid} {
      allow get: if isAdmin()
                || (signedIn() && request.auth.uid == uid)
                || (resource.data.approved == true);
      allow list: if isAdmin() || signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      function isOwner() {
        return signedIn() && (
          (resource.data.ownerUid is string && resource.data.ownerUid == request.auth.uid)
          || (resource.data.guideUid is string && resource.data.guideUid == request.auth.uid)
        );
      }

      function isPublicItem() {
        return (resource.data.status in ["published", "approved"]);
      }

      allow get: if isAdmin() || isOwner() || isPublicItem();
      allow list: if true;
      allow create: if signedIn()
        && (request.resource.data.ownerUid is string)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || isOwner();
      allow delete: if isAdmin()
        || (signedIn() && (resource.data.ownerUid is string) && resource.data.ownerUid == request.auth.uid);

      match /reviews/{uid} {
        allow get, list: if isAdmin() || isPublicItem() || isOwner();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    match /reviews/{orderId} {
      function orderExistsAndMine() {
        return signedIn()
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid == request.auth.uid
          && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.paymentStatus in ["confirmed","settled","completed"]
            || get(/databases/$(database)/documents/orders/$(orderId)).data.status in ["confirmed","settled","completed"]
          );
      }

      function isReviewAuthor() {
        return signedIn()
          && (resource.data.authorUid is string)
          && resource.data.authorUid == request.auth.uid;
      }

      function isReviewGuide() {
        return signedIn()
          && (resource.data.guideUid is string)
          && resource.data.guideUid == request.auth.uid;
      }

      function authorUpdateOnly() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(["rating","text","updatedAt"]);
      }

      function guideReplyOnly() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(["guideReply","updatedAt"]);
      }

      allow get, list: if true;
      allow create: if orderExistsAndMine()
        && (request.resource.data.authorUid is string)
        && request.resource.data.authorUid == request.auth.uid
        && (request.resource.data.orderId == orderId);
      allow update: if isAdmin()
        || (isReviewAuthor() && authorUpdateOnly())
        || (isReviewGuide() && guideReplyOnly());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin()
        || isStaff()
        || (isOrderBuyer() && buyerPayProofUpdateOnly())
        || belongsToTenant(resource.data.tenantId);
      allow delete: if isAdmin();
    }

    match /slots/{slotId} {
      allow get, list: if true;
      allow create: if signedIn()
        && (request.resource.data.itemId is string)
        && (request.resource.data.date is string)
        && (request.resource.data.capacity is number)
        && (request.resource.data.booked is number)
        && request.resource.data.booked >= 0
        && request.resource.data.capacity >= 0;
      allow update: if signedIn()
        && (resource.data.booked is number)
        && (request.resource.data.booked is number)
        && request.resource.data.booked >= resource.data.booked;
      allow delete: if isAdmin();
    }

    // users/{uid} (BestClubVN + BestERP + 가맹점 웹 통합)
    match /users/{uid} {
      allow get, list: if signedIn();
      // 권한(role)·소속 필드는 본사 관리자, 자기 가맹점 직원을 관리하는 점주, 직원 본인 연결(employees 대조)로만 바뀐다.
      allow create: if selfUserWriteOk(uid)
        || isAdmin()
        || ceoManagesUserOk(uid)
        || selfStaffClaimOk(uid);
      allow update: if selfUserWriteOk(uid)
        || isAdmin()
        || ceoManagesUserOk(uid)
        || selfStaffClaimOk(uid);
      allow delete: if isAdmin();

      match /myMap/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /settlements/{ym} {
      allow get: if isAdmin() || signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /guides/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /settlementRuns/{ym} {
      allow get: if isAdmin() || signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /guides/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /guideOrders/{guideUid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == guideUid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /orders/{orderId} {
        allow get, list: if isAdmin() || (signedIn() && request.auth.uid == guideUid);
        allow create, update, delete: if isAdmin();
      }
    }

    match /settings/{docId} {
      allow get: if true;
      allow list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // deposits (VND / KRW 충전 요청 및 내역 조회)
    match /deposits/{refCode} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /hexDeposits/{refCode} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /mentors/{email} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mentorRequests/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /transactions/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /kca_webzine/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // merchants (BestClubVN & BestERP 공통 가맹점 마스터)
    match /merchants/{merchantId} {
      allow get, list: if true;
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.active == false
            && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['active', 'status', 'approvedAt', 'approvedBy', 'feeBps', 'ownerUid', 'apiKey'])
            && (
              (resource.data.ownerUid is string && resource.data.ownerUid == request.auth.uid)
              || request.auth.uid == merchantId
              || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.merchantId == merchantId)
            ));
    }

    match /places/{placeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coopConfig/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coopProducts/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coopOrders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /sponsorBanners/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /jackpot_rounds/{roundId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /jackpot_wins/{docId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /jackpot_config/{docId} {
      allow get, list: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /jackpot_stats/{docId} {
      allow get, list: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /usedMarketPosts/{postId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.sellerUid is string
        && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn()
            && resource.data.sellerUid is string
            && resource.data.sellerUid == request.auth.uid);
    }

    match /ohlc/{docId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ── 보물찾기 & 배틀 시스템 ────────────────────────────────────────────────
    match /treasure_items/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /treasure_keys/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /treasure_boxes/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /treasure_inventory/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if signedIn();
    }
    match /treasure_logs/{docId} {
      allow get: if signedIn()
        && docId.matches(request.auth.uid + '_.*');
      allow list: if isAdmin();
      allow write: if false;
    }
    match /treasure_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /treasure_vouchers/{docId} {
      allow get, list: if true;
      allow write: if false;
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /treasure_voucher_logs/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /treasure_inventory_boxes/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /treasure_voucher_purchases/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /dropped_items/{docId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /battle_monsters/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /battle_towers/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /map_decorations/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /battle_players/{uid} {
      allow get, list: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['gold']);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gold']);
      allow delete: if isAdmin();
    }

    // ── 커뮤니티 / 이벤트 / 버기카 / DAO / 게임 상점 ─────────────────────────
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId is string
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /community_events/{eventId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);

      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isAdmin()
          || (signedIn()
              && reviewId == request.auth.uid
              && !exists(/databases/$(database)/documents/community_events/$(eventId)/reviews/$(request.auth.uid)));
        allow update, delete: if isAdmin();
      }

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /community_event_vouchers/{docId} {
      allow get, list: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /community_voucher_settlements/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow write: if false;
    }

    function isRegisteredDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/buggy_drivers/$(request.auth.uid));
    }

    match /buggy_config/{docId} {
      allow get, list: if true;
      allow write: if false;
    }
    match /buggy_rides/{rideId} {
      allow get, list: if isAdmin()
        || isRegisteredDriver()
        || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid));
      allow write: if false;
    }
    match /buggy_drivers/{driverUid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == driverUid);
      allow list: if isAdmin();
      allow write: if false;
    }
    match /buggy_driver_locations/{driverUid} {
      allow get, list: if signedIn();
      allow write: if signedIn() && request.auth.uid == driverUid;
    }
    match /buggy_transactions/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /ride_audit_logs/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /payment_attempt_logs/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /buggy_driver_earnings/{docId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    match /dao_proposals/{proposalId} {
      allow get, list: if true;
      allow write: if false;

      match /supporters/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin();
        allow write: if false;
      }
      match /votes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin();
        allow write: if false;
      }
      match /comments/{commentId} {
        allow get, list: if true;
        allow write: if false;
      }
    }

    match /game_shops/{shopId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shop_sales_logs/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /user_sessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      allow list: if false;
    }

    match /user_locations/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /battle_hp/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /admin_status/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /support_chats/{uid} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;

      match /messages/{msgId} {
        allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow update: if isAdmin()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByUser"]));
        allow delete: if false;
      }
    }

    match /device_accounts/{deviceId} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /nfc_tags/{tagId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /nfc_claims/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /tutorial_boxes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /slot_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /user_treasures/{docId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    match /user_treasure_npcs/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /coopTreasurePackages/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /packageComments/{docId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /stockOptionVouchers/{docId} {
      allow get, list: if signedIn();
      allow write: if false;
    }
    match /voucherTransfers/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /optionExecutions/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /membership_config/{docId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /membership_payments/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /membership_referrals/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && (
          resource.data.referrerUid == request.auth.uid
          || resource.data.newUserUid == request.auth.uid
        ));
      allow write: if false;
    }

    match /pending_referrals/{docId} {
      allow get: if signedIn() && request.auth.uid == docId;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /npc_characters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webzine_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupon_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_coupons/{userCouponId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /coupon_redemptions/{redemptionId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin() || signedIn();
      allow delete: if isAdmin();
    }

    // ── BestERP & 가맹점 SaaS 통합 컬렉션 ────────────────────────────────────

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isCEO() || isStaff() || belongsToTenant(storeId);
    }

    match /materials/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isCEO() || isAuthenticated();
    }

    match /suppliers/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isCEO() || isAuthenticated();
    }

    match /priceHistory/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isCEO() || isAuthenticated();
    }

    match /externalPrices/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isCEO() || isAuthenticated();
    }

    match /merchant_products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /merchant_members/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isCEO() || isAuthenticated();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /merchant_orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /projects/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /purchaseRequests/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /purchase_requests/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /access_requests/{document=**} {
      allow read, write: if isAuthenticated();
      allow create: if true;
    }

    match /financeRecords/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 직원 원장: 자기 가맹점 직원만 관리. 본인(contact 이메일)은 자기 직원 문서를 읽을 수 있다(첫 로그인 연결용).
    match /employees/{empId} {
      allow read: if belongsToTenant(resource.data.get('tenantId', null))
        || (signedIn() && request.auth.token.email_verified == true
            && (request.auth.token.email is string)
            && resource.data.get('contact', '') == request.auth.token.email);
      allow create: if isAdmin()
        || (isCEO() && isMyTenant(request.resource.data.get('tenantId', null)));
      allow update: if isAdmin()
        || (isCEO() && isMyTenant(resource.data.get('tenantId', null))
            && request.resource.data.get('tenantId', null) == resource.data.get('tenantId', null));
      allow delete: if isAdmin()
        || (isCEO() && isMyTenant(resource.data.get('tenantId', null)));
    }

    match /clients/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /contacts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /siteLogs/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /aiInsights/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /system_branding/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isCEO();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /task_reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    match /task_comments/{commentId} {
      allow read, write: if isAuthenticated();
    }

    match /task_attachments/{attachmentId} {
      allow read, write: if isAuthenticated();
    }

    match /task_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // ── AI NVR (매장 Frigate NVR 미들웨어 연동) ──────────────────────────────────
    // nvr_* 문서는 매장 NVR 미들웨어가 Admin SDK로만 기록한다 (클라이언트 쓰기 금지).
    // 얼굴 이미지·임베딩·스냅샷은 저장하지 않는다.
    match /nvr_status/{merchantId} {
      allow read: if belongsToTenant(merchantId);
      allow write: if false;
    }

    match /nvr_attendance/{docId} {
      allow read: if belongsToTenant(resource.data.merchantId);
      allow write: if false;
    }

    match /nvr_vip_visits/{docId} {
      allow read: if belongsToTenant(resource.data.merchantId);
      allow write: if false;
    }

    // 방범 이력: 가맹점 소속 사용자 조회 허용 (쓰기는 기존대로 superadmin / Admin SDK)
    match /security_incident_logs/{docId} {
      allow read: if belongsToTenant(resource.data.merchantId);
    }

    // 매장 직원 원장: 가맹점 소속 사용자가 자기 가맹점 직원만 관리 (merchantId 변경 금지)
    match /store_employees/{docId} {
      allow read: if belongsToTenant(resource.data.merchantId);
      allow create: if belongsToTenant(request.resource.data.merchantId);
      allow update: if belongsToTenant(resource.data.merchantId)
        && request.resource.data.merchantId == resource.data.merchantId;
      allow delete: if belongsToTenant(resource.data.merchantId);
    }

    // ── Table QR & AI Smart CRM Collections ────────────────────────────────────
    match /store_customers/{document=**} {
      allow read, write: if true;
    }

    match /store_visits/{document=**} {
      allow read, write: if true;
    }

    match /merchant_traffic_logs/{document=**} {
      allow read, write: if true;
    }

    match /user_coupons/{document=**} {
      allow read, write: if true;
    }

  }
}
