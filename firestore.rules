rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { 
      return request.auth != null; 
    }

    function getUserData() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : {"role": "EMPLOYEE"};
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'daguri75@gmail.com' ||
        getUserData().role == 'SUPER_ADMIN'
      );
    }

    // CEO ?먮뒗 理쒓퀬愿由ъ옄 ?뺤씤 (daguri75@gmail.com? 臾댁“嫄??곸슜)
    function isCEO() {
      return isAuthenticated() && (
        request.auth.token.email == 'daguri75@gmail.com' ||
        getUserData().role == 'SUPER_ADMIN' || 
        getUserData().role == 'CEO'
      );
    }
    
    // ?쇰컲 吏곸썝/愿由ъ옄 ?댁긽 (?곌린 沅뚰븳??
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.email == 'daguri75@gmail.com' ||
        getUserData().role in ['SUPER_ADMIN', 'CEO', 'ADMIN', 'STAFF']
      );
    }

    // 湲곕낯?곸쑝濡?CEO??紐⑤뱺 而щ젆?섏뿉???쎄린/?곌린/??젣 ?꾨꼍??沅뚰븳??媛吏?    
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ?쇰컲 吏곸썝(Staff) ?댁긽??沅뚰븳
    match /materials/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /suppliers/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /priceHistory/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /externalPrices/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      // ?먯떊 ?뺣낫 ?섏젙 ?덉슜 ?먮뒗 CEO
      allow write: if request.auth.uid == userId || isSuperAdmin();
    }
    
    match /projects/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /purchaseRequests/{document=**} { allow read: if isAuthenticated(); allow write: if isAuthenticated(); }
    
    // ?덈줈 ?ㅺ퀎??AI 寃쎌쁺李몃え???듯빀 DB Rules
    match /employees/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /clients/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /contacts/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /siteLogs/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /aiInsights/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }

    // ?낅Т 諛?蹂닿퀬 ?쒖뒪??(Task Management System)
    match /system_branding/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isCEO();
    }

    match /tasks/{taskId} {
      allow read: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER' && resource.data.teamId == getUserData().teamId)
        || (isAuthenticated() && resource.data.assignedTo == request.auth.token.email);
      allow write: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER' && resource.data.teamId == getUserData().teamId)
        || (isAuthenticated() && resource.data.assignedTo == request.auth.token.email);
    }

    match /task_reports/{reportId} {
      allow read: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated() && resource.data.submittedBy == request.auth.uid);
      allow write: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated() && request.resource.data.submittedBy == request.auth.uid);
    }

    match /task_comments/{commentId} {
      allow read: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated());
      allow write: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    match /task_attachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /task_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}


